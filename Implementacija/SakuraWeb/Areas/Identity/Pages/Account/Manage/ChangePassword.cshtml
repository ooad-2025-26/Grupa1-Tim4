@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Promjena lozinke";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />
<div class="postavke-pozadina">
    <div class="container" style="max-width:40%;">
        <br><h1 class="stack-sans-headline-h1"><b>@ViewData["Title"]</b></h1><br>
        <form id="profile-form" method="post">
            <div class="wittgenstein">
                <p>
                    <label asp-for="Input.OldPassword" class="form-label">Stara lozinka:</label>
                    <input asp-for="Input.OldPassword" class="form-control mb-3" autocomplete="current-password" aria-required="true" placeholder="Stara lozinka..." />
                    <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                </p>
                <p>
                    
                    <label asp-for="Input.NewPassword">Nova lozinka:</label>
                    <input asp-for="Input.NewPassword" class="form-control mb-3" autocomplete="new-password" aria-required="true" placeholder="Nova lozinka..." />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </p>
                <p>
                    <label asp-for="Input.ConfirmPassword">Potvrdite lozinku:</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control mb-3" autocomplete="new-password" aria-required="true" placeholder="Nova lozinka..." />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </p>
            </div>
            <button type="submit" class="sakura-btn-dark" style="width:100%; margin-top:20px">Promijeni lozinku</button>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
