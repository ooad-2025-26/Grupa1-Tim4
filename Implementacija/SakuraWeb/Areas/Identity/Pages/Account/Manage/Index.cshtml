@page
@model IndexModel
@{
    ViewData["Title"] = "Postavke računa";
    ViewData["ActivePage"] = ManageNavPages.Index;
}
<div class="postavke-pozadina">
    <div class="container" style="max-width:40%;">
        <br><h1 class="stack-sans-headline-h1"><b>@ViewData["Title"]</b></h1><br>
        <form id="profile-form" method="post">
            <div class="wittgenstein">
                <!--<label for="email">Email adresa:</label>
                <input type="email" class="form-control mb-3" id="email" placeholder="Email adresa...">-->
                <label asp-for="Input.KorisnickoIme">Korisničko ime:</label>
                <input type="text" class="form-control mb-3" asp-for="Input.KorisnickoIme" placeholder="Korisničko ime...">
                <p>Ovdje možete promijeniti status vaše pretplate na newsletter:</p>
                <input type="checkbox" asp-for="Input.PretplatiteSeNaNewsletter" checked="@(Model.Input.PretplatiteSeNaNewsletter ? "checked" : null)" />
                <label asp-for="Input.PretplatiteSeNaNewsletter" style="margin-left:10px;">Želim primati obavijesti o novim proizvodima, uslugama i popustima.</label>
            </div>
            <button type="submit" id="update-profile-button" class="sakura-btn-dark" style="width:100%; margin-top:20px">Ažuriraj</button>
        </form>
        
        <p class="wittgenstein mt-3">Želite li promijeniti lozinku? Kliknite <a asp-page="./ChangePassword">ovdje</a>.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
