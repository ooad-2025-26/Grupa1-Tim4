@model IEnumerable<SakuraWeb.Models.Proizvod>

@{
    ViewData["Title"] = "Proizvodi";
}


@if (User.IsInRole("Administrator"))
{
    <partial name="_AdminNavPartial"></partial>

  <div class="shadow-lg rounded-4 p-4 w-100 sakura-lightgray-bg mb-4 mt-4">
        <h2 class="text-center mb-4">Izmjena proizvoda</h2>

        <a asp-action="Create" class="sakura-btn-dark mb-2">Dodajte novi proizvod</a>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>
                            Naziv
                        </th>
                        <th>
                            Cijena
                        </th>
                        <th>
                            Kategorija
                        </th>
                        <th>
                            Volumen
                        </th>
                        <th>
                            Slika
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
@foreach (var item in Model) {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.naziv)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.cijena)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.kategorija)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.volumen)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.slikaPutanja)
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.id">Uredi</a> |
                            <a asp-action="Details" asp-route-id="@item.id">Detalji</a>|
                            <a asp-action="Delete" asp-route-id="@item.id">Izbriši</a>
                        </td>
                    </tr>
}
                </tbody>
            </table>
        </div>
    </div>

} else {

<header class="sakura-header-grad push-it-down">
    <h1 class="stack-sans-headline-h1 sakura-hotpink text-center">Proizvodi</h1>
</header>



<div class="container">
    <div class="d-flex justify-content-end">
        <div class="d-3">
            <!--<form asp-action="Create">
                <input type="submit" value="Create" class="sakura-btn-dimmed" />
            </form>-->
            <button class="sakura-btn-dimmed" asp-action="Create">Filtriraj</button>
            <button class="sakura-btn-dark">Sortiraj</button>
        </div>
    </div>
    <div class="proizvodi-container mx-auto row scroll-container-proizvodi">
@foreach (var item in Model) {
    var naslov = item.naziv;
    //if(naslov.Length>25) naslov=naslov.Substring(0,25)+"...";
            <div class="col-sm-3 p-2">
                <div class="proizvod-card-proizvodi d-flex flex-column align-items-center">

                    <div class="image-wrapper-proizvodi">
                        <img src="~/img/@item.slikaPutanja" alt="@item.naziv">
                    </div>

                    <p class="wittgenstein-proizvodi text-center">@naslov</p>

                    <div class="volumen-cijena-proizvodi mt-auto">
                        <span> <a asp-controller="Proizvodi" asp-action="Details" asp-route-id="@item.id">@item.cijena KM</a></span>
                    </div>

                </div>
            </div>
}
        <!--<div class="col-sm proizvod-min-container d-flex flex-column align-items-center">
            <div>
                <img src="img/product-image-2.jpg">
                <p class="wittgenstein">Densifique Fondant Densité Rege...</p>
            </div>
            <div class="volumen-cijena">
                <span>200ml</span>
                <span>110 KM</span>
            </div>
        </div>
        <div class="col-sm proizvod-min-container d-flex flex-column align-items-center">
            <div>
                <img src="img/product-image-3.jpg">
                <p class="wittgenstein">Densifique Densimorphose® Pjena</p>
            </div>
            <div class="volumen-cijena">
                <span>150ml</span>
                <span>50 KM</span>
            </div>
        </div>-->
    </div>
</div>
}