@model IEnumerable<SakuraWeb.Models.Proizvod>

@{
    ViewData["Title"] = "Index";
}

<header class="sakura-header-grad push-it-down">
    <h1 class="stack-sans-headline-h1 sakura-hotpink text-center">Proizvodi</h1>
</header>



<div class="container">
    <div class="d-flex justify-content-end">
        <div class="d-3">
            <!--<form asp-action="Create">
                <input type="submit" value="Create" class="sakura-btn-dimmed" />
            </form>-->
            <button class="sakura-btn-dimmed" asp-action="Create">Filtriraj</button>
            <button class="sakura-btn-dark">Sortiraj</button>
        </div>
    </div>
    <div class="proizvodi-container mx-auto row">
@foreach (var item in Model) {
    var naslov = item.naziv;
    if(naslov.Length>25) naslov=naslov.Substring(0,25)+"...";
        <div class="col-sm proizvod-min-container d-flex flex-column align-items-center">
            <div>
                <!--<img src="img/product-image-1.jpg">-->
                <img src="~/img/@item.slikaPutanja" alt="@item.naziv">
                    <p class="wittgenstein">@naslov</p>
            </div>
            <div class="volumen-cijena">
                    <span>@Html.DisplayFor(modelItem => item.volumen) ml</span>
                    <span>@Html.DisplayFor(modelItem => item.cijena) KM</span>
            </div>
        </div>
}
        <!--<div class="col-sm proizvod-min-container d-flex flex-column align-items-center">
            <div>
                <img src="img/product-image-2.jpg">
                <p class="wittgenstein">Densifique Fondant Densité Rege...</p>
            </div>
            <div class="volumen-cijena">
                <span>200ml</span>
                <span>110 KM</span>
            </div>
        </div>
        <div class="col-sm proizvod-min-container d-flex flex-column align-items-center">
            <div>
                <img src="img/product-image-3.jpg">
                <p class="wittgenstein">Densifique Densimorphose® Pjena</p>
            </div>
            <div class="volumen-cijena">
                <span>150ml</span>
                <span>50 KM</span>
            </div>
        </div>-->
    </div>
</div>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.naziv)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.cijena)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.kategorija)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.volumen)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.slikaPutanja)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.naziv)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.cijena)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.kategorija)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.volumen)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.slikaPutanja)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
