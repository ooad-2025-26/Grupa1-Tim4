    <div class="d-flex justify-content-end gap-3">
        <div class="dropdown">
            <button class="sakura-btn-dark dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    style="padding-left:50px;padding-right:50px;">
                Sortiraj
            </button>

            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item"
                       asp-controller="Proizvodi"
                       asp-action="Index"
                       asp-route-sort="CijenaUzlazno">
                        Cijena uzlazno
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-controller="Proizvodi"
                       asp-action="Index"
                       asp-route-sort="CijenaSilazno">
                        Cijena silazno
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-controller="Proizvodi"
                       asp-action="Index"
                       asp-route-sort="NazivUzlazno">
                        Naziv uzlazno
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-controller="Proizvodi"
                       asp-action="Index"
                       asp-route-sort="NazivSilazno">
                        Naziv silazno
                    </a>
                </li>
            </ul>
        </div>
        <div class="dropdown">
            <button class="sakura-btn-dark dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    style="padding-left:50px;padding-right:50px;">
                Filtriraj
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item"
                       asp-controller="Proizvodi"
                       asp-action="Index"
                       asp-route-kategorija="Sve">
                        Prikaži sve
                    </a>
                </li>
            @foreach (var item in Html.GetEnumSelectList<KategorijaProizvoda>())
            {
                <li>
                    <a class="dropdown-item"
                       asp-controller="Proizvodi"
                       asp-action="Index"
                       asp-route-kategorija="@item.Value">
                        @item.Text
                    </a>
                </li>
            }
            </ul>
        </div>
        </div>
