@model SakuraWeb.Models.Proizvod

@{
    ViewData["Title"] = "Delete";
}
@if (User.IsInRole("Administrator"))
{
    <partial name="_AdminNavPartial"></partial>

    <div class="shadow-lg rounded-4 p-4 sakura-lightgray-bg mb-4 mt-4 container" style="width:60%;">
        <h2 class="mb-4 admin-panel-heading">Brisanje proizvoda</h2>

        <div class="">
            <div class="col-md-8">
                <h4>Jeste li sigurni da želite obrisati ovaj proizvod?</h4>
                <dl class="row mt-3">
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.naziv)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.naziv)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.cijena)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.cijena)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.kategorija)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.kategorija)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.volumen)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.volumen)
                    </dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="id" />
                    <div class="form-group mt-2">
                        <input type="submit" value="Izbriši" class="sakura-btn-dark" />
                        <a asp-action="Index" class="sakura-btn-dimmed">Nazad na listu proizvoda</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

}