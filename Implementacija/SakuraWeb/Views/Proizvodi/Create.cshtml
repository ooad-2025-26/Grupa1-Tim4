@model SakuraWeb.Models.Proizvod

@{
    ViewData["Title"] = "Create";
}
@if (User.IsInRole("Administrator"))
{
    <partial name="_AdminNavPartial"></partial>

    <div class="shadow-lg rounded-4 p-4 sakura-lightgray-bg mb-4 mt-4 container" style="width:60%;">
        <h2 class="mb-4 admin-panel-heading">Novi proizvod</h2>

        <div class="">
            <div class="col-md-8">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="naziv" class="control-label">Naziv</label>
                        <input asp-for="naziv" class="form-control" />
                        <span asp-validation-for="naziv" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="cijena" class="control-label">Cijena (u KM)</label>
                        <input asp-for="cijena" class="form-control" />
                        <span asp-validation-for="cijena" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="kategorija" class="control-label">Kategorija</label>
                        <select asp-for="kategorija" class="form-control" asp-items="Html.GetEnumSelectList<SakuraWeb.Models.KategorijaProizvoda>()"></select>
                        <span asp-validation-for="kategorija" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="volumen" class="control-label">Volumen</label>
                        <input asp-for="volumen" class="form-control" />
                        <span asp-validation-for="volumen" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="poeniPr" class="control-label">Poeni</label>
                        <input asp-for="poeniPr" class="form-control" />
                        <span asp-validation-for="poeniPr" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Benefiti</label>
                        <div>
                            @foreach (var benefit in (List<SakuraWeb.Models.Benefit>)ViewData["Benefiti"]!)
                            {
                                <div class="form-check">
                                    <input type="checkbox" name="benefitIds" value="@benefit.id" class="form-check-input" id="benefit_@benefit.id" />
                                    <label class="form-check-label" for="benefit_@benefit.id">@benefit.opis</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Sastojci</label>
                        <div>
                            @foreach (var sastojak in (List<SakuraWeb.Models.Sastojak>)ViewData["Sastojci"]!)
                            {
                                <div class="form-check">
                                    <input type="checkbox" name="sastojakIds" value="@sastojak.id" class="form-check-input" id="sastojak_@sastojak.id" />
                                    <label class="form-check-label" for="sastojak_@sastojak.id">@sastojak.naziv</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Slika</label>
                        <input type="file" name="slika" class="form-control" accept="image/*" />
                    </div>
                    <div class="form-group mt-2">
                        <input type="submit" value="Dodaj proizvod" class="sakura-btn-dark" />
                        <a asp-action="Index" class="sakura-btn-dimmed">Nazad na listu proizvoda</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}