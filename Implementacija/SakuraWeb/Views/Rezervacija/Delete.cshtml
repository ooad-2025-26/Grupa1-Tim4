@model SakuraWeb.Models.Rezervacija

@{
    ViewData["Title"] = "Izbriši rezervaciju";
}

<div class="container sakura-lightgray-bg rounded-4 shadow-lg p-4 mt-4 mb-4" style="width:60%;">
    <h4>Jeste li sigurni da želite izbrisati ovu rezervaciju?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Datum
        </dt>
        <dd class="col-sm-10">
            @Model.datumRezervacije.ToString("dd.MM.yyyy.")
        </dd>
        <dt class="col-sm-2">
            Vrijeme
        </dt>
        <dd class="col-sm-10">
            @Model.vrijemeTermina.ToString("HH:mm")
        </dd>
        <dt class="col-sm-2">
            Otkazana
        </dt>
        <dd class="col-sm-10">
            @(Model.otkazana ? "Da" : "Ne")
        </dd>
        <dt class="col-sm-2">
            Ocjena
        </dt>
        <dd class="col-sm-10">
            @Model.ocjena
        </dd>
        <dt class="col-sm-2">
            Klijent
        </dt>
        <dd class="col-sm-10">
            @Model.klijent.korisnickoIme
        </dd>
        <dt class="col-sm-2">
            Frizer
        </dt>
        <dd class="col-sm-10">
            @(Model.frizer?.korisnickoIme ?? "Nije dodijeljen")
        </dd>
        <dt class="col-sm-2">
            Usluga
        </dt>
        <dd class="col-sm-10">
            @Model.usluga.naziv
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="id" />
        <input type="submit" value="Izbriši" class="sakura-btn-dark" style="padding-right:20px" />
        <a asp-action="Index" class="sakura-btn-dark">Nazad na spisak</a>
    </form>
</div>
