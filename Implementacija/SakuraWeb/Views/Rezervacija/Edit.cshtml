@model SakuraWeb.Models.Rezervacija

@{
    ViewData["Title"] = "Pomjeri termin";
}

<div class="shadow-lg rounded-4 p-4 w-100 sakura-lightgray-bg mb-4 mt-4">
    <h2 class="text-center mb-4 admin-panel-heading">Pomjeri termin</h2>

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Usluga</dt>
                <dd class="col-sm-8">@Model.usluga.naziv</dd>

                <dt class="col-sm-4">Klijent</dt>
                <dd class="col-sm-8">@Model.klijent.korisnickoIme</dd>

                <dt class="col-sm-4">Frizer</dt>
                <dd class="col-sm-8">@(Model.frizer?.korisnickoIme ?? "Nije dodijeljen")</dd>
            </dl>

            <form asp-action="Edit">
                <input type="hidden" asp-for="id" />
                <div class="form-group mb-3">
                    <label for="datumRezervacije" class="control-label">Datum</label>
                    <input type="date" id="datumRezervacije" name="datumRezervacije" class="form-control" value="@Model.datumRezervacije.ToString("yyyy-MM-dd")" required>
                </div>
                <div class="form-group mb-3">
                    <label for="vrijemeTermina" class="control-label">Vrijeme</label>
                    <input type="time" id="vrijemeTermina" name="vrijemeTermina" class="form-control" value="@Model.vrijemeTermina.ToString("HH:mm")" required>
                </div>
                <div class="form-group">
                    <input type="submit" value="Pomjeri" class="sakura-btn-dark" />
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index">Nazad na pregled</a>
</div>
