<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SakuraWeb</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Stack+Sans+Headline:wght@200..700&family=Wittgenstein:ital,wght@0,400..900;1,400..900&display=swap">

    <link rel="stylesheet" href="~/css/site.css"  />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!--<link rel="stylesheet" href="~/SakuraWeb.styles.css" asp-append-version="true" />-->
</head>
<body>
    <div class="header">
        <img class="" src="~/img/Header.svg" />
    </div>
    <div class="navbar navbar-expand">
        <div class="container-fluid d-flex justify-content-between">
            <!-- LEFT -->
            <div class="d-flex gap-2">
                <a class="nav-link sakura-btn-active" asp-controller="Home" asp-action="Index">Početna</a>
                <a class="nav-link sakura-lightgray" asp-controller="Proizvodi" asp-action="Index">Proizvodi</a>
                <a class="nav-link sakura-lightgray" asp-controller="Usluga" asp-action="Index">Usluge</a>
                <a class="nav-link sakura-lightgray" asp-controller="Anketa" asp-action="Index">Anketa</a>
                <a class="nav-link sakura-lightgray" asp-controller="Newsletter" asp-action="Index">Newsletter</a>
            </div>

            <!-- RIGHT -->
            <partial name="_LoginPartial"></partial>

        </div>
    </div>

    <main role="main" class="pb-3">
        @RenderBody();
    </main>
    

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
