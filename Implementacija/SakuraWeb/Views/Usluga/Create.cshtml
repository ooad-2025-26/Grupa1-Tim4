@model SakuraWeb.Models.Usluga

@{
    ViewData["Title"] = "Create";
}
@if (User.IsInRole("Administrator"))
{
    <partial name="_AdminNavPartial"></partial>

    <div class="shadow-lg rounded-4 p-4 sakura-lightgray-bg mb-4 mt-4 container" style="width:60%;">
        <h2 class="mb-4 admin-panel-heading">Nova usluga</h2>

        <div class="">
            <div class="col-md-8">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="naziv" class="control-label">Naziv</label>
                        <input asp-for="naziv" class="form-control" />
                        <span asp-validation-for="naziv" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="opis" class="control-label">Opis</label>
                        <input asp-for="opis" class="form-control" />
                        <span asp-validation-for="opis" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="cijena" class="control-label">Cijena (u KM)</label>
                        <input asp-for="cijena" class="form-control" />
                        <span asp-validation-for="cijena" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="kategorija" class="control-label">Kategorija</label>
                        <select asp-for="kategorija" class="form-control" asp-items="Html.GetEnumSelectList<KategorijaUsluga>()"></select>
                        <span asp-validation-for="kategorija" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="trajanje" class="control-label">Trajanje (u minutama)</label>
                        <input asp-for="trajanje" class="form-control" />
                        <span asp-validation-for="trajanje" class="text-danger"></span>
                    </div>
                    <div class="form-group mt-2">
                        <input type="submit" value="Dodaj uslugu" class="sakura-btn-dark" />
                        <a asp-action="Index" class="sakura-btn-dimmed">Nazad na listu usluga</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

} else {
    <p>wee woo</p>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}