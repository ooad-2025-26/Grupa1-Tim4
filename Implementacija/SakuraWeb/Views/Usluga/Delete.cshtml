@model SakuraWeb.Models.Usluga

@{
    ViewData["Title"] = "Delete";
}

<div class="container sakura-lightgray-bg rounded-4 shadow-lg p-4 mt-4 mb-4" style="width:60%;">
    <h4>Jeste li sigurni da želite izbrisati ovu uslugu?</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Naziv
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.naziv)
        </dd>
        <dt class = "col-sm-2">
            Opis
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.opis)
        </dd>
        <dt class = "col-sm-2">
            Cijena
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cijena)
        </dd>
        <dt class = "col-sm-2">
            Kategorija
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.kategorija)
        </dd>
        <dt class = "col-sm-2">
            Trajanje
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.trajanje)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="id" />
        <input type="submit" value="Izbriši" class="sakura-btn-dark" style="padding-right:20px"/>
        <a asp-action="Index" class="sakura-btn-dark">Nazad na spisak</a>
    </form>
</div>
