@model IEnumerable<SakuraWeb.Models.Usluga>

@{
    ViewData["Title"] = "Izmjena usluga";
}
@if (User.IsInRole("Administrator"))
{
    <partial name="_AdminNavPartial"></partial>

    <div class="shadow-lg rounded-4 p-4 w-100 sakura-lightgray-bg mb-4 mt-4">
    <h2 class="text-center mb-4 admin-panel-heading">Izmjena usluga</h2>

    <a asp-action="Create" class="sakura-btn-dark mb-2">Dodajte novu uslugu</a>
    <div class="table-responsive">
        <table class="table table-striped">
        <thead>
            <tr>
                <th>
                   Naziv
                </th>
                <th>
                    Opis
                </th>
                <th>
                    Cijena (u KM)
                </th>
                <th>
                    Kategorija
                </th>
                <th>
                    Trajanje (u minutama)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.naziv)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.opis)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.cijena)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.kategorija)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.trajanje)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.id">Uredi</a> |
                    <a asp-action="Delete" asp-route-id="@item.id">Izbriši</a>
                </td>
            </tr>
    }
        </tbody>
        </table>
    </div>
</div>

} else {
    <p>wee woo</p>
}
